# Copy to .env (git-ignored) and fill in. Every variable the code or the compose file reads is here.

# --- docker-compose.yml only (host side) ---
KEEPSAKE_PASSWORD=CHANGE_ME_at_least_10_characters
KEEPSAKE_SOURCES_HOST_DIR=/path/to/the/folders/you/want/kept
KEEPSAKE_ICLOUD_HOST_DIR=/path/to/iCloud-Drive/Keepsake
KEEPSAKE_HOST_PORT=8765

# --- the app (also valid when running natively with python -m keepsake) ---
KEEPSAKE_DATA=/data
KEEPSAKE_CONFIG=
KEEPSAKE_ICLOUD_DIR=/icloud
KEEPSAKE_ROOTS=sources=/sources
# Broad read-only mounts the page may add locations under (Settings, Locations)
KEEPSAKE_LOCATION_PREFIXES=/hostfs
KEEPSAKE_FS_ROOTS=
KEEPSAKE_ROOT_MARKERS=
TZ=UTC

# Safety limits (also editable on the Settings page)
KEEPSAKE_MAX_DEST_GB=150
KEEPSAKE_MIN_FREE_GB=20
KEEPSAKE_SHRINK_PCT=20
KEEPSAKE_PAUSE_MS=0
KEEPSAKE_MAX_MBPS=0

# Web server. Loopback needs no password; anything else is refused without one.
KEEPSAKE_HOST=127.0.0.1
KEEPSAKE_PORT=8765
KEEPSAKE_PASSWORD_FILE=
KEEPSAKE_COOKIE_SECURE=0
KEEPSAKE_ALLOWED_HOSTS=

# Optional notifiers
KEEPSAKE_WEBHOOK_URL=
KEEPSAKE_WEBHOOK_URL_FILE=
KEEPSAKE_MQTT_HOST=
KEEPSAKE_MQTT_PORT=1883
KEEPSAKE_MQTT_USER=
KEEPSAKE_MQTT_PASSWORD=
KEEPSAKE_MQTT_PASSWORD_FILE=
KEEPSAKE_MQTT_PREFIX=keepsake
# MQTT discovery: the topic prefix your home automation hub listens on. Set it and Keepsake also
# announces itself there, with a live status entity per folder. Empty: alert events only.
KEEPSAKE_MQTT_DISCOVERY_PREFIX=

# ntfy: the topic address is the secret, anyone who has it can read the topic
KEEPSAKE_NTFY_URL=
KEEPSAKE_NTFY_URL_FILE=
KEEPSAKE_NTFY_TOKEN=
KEEPSAKE_NTFY_TOKEN_FILE=

# Pushover: needs both the application token and your user key
KEEPSAKE_PUSHOVER_TOKEN=
KEEPSAKE_PUSHOVER_TOKEN_FILE=
KEEPSAKE_PUSHOVER_USER=
KEEPSAKE_PUSHOVER_USER_FILE=

# E-mail: host, from and to are all needed. SECURITY is starttls, ssl or none;
# a login is refused with none.
KEEPSAKE_SMTP_HOST=
KEEPSAKE_SMTP_PORT=587
KEEPSAKE_SMTP_SECURITY=starttls
KEEPSAKE_SMTP_USER=
KEEPSAKE_SMTP_PASSWORD=
KEEPSAKE_SMTP_PASSWORD_FILE=
KEEPSAKE_SMTP_FROM=
KEEPSAKE_SMTP_TO=
